.threat-level-card .tl-metric{background:rgba(0,0,0,.3);border-radius:6px;padding:.3rem .5rem}
.threat-level-card .tl-m-label{color:var(--text-dim);text-transform:uppercase;font-size:.45rem;letter-spacing:.5px}
.threat-level-card .tl-m-val{font-family:'Courier New',monospace;font-weight:800;color:var(--cyan);font-size:.7rem;margin-top:1px}
.alliance-matrix{background:rgba(0,0,0,.5);border-radius:14px;padding:.9rem;border:1px solid rgba(179,136,255,.15);margin-top:.8rem;position:relative;z-index:2}
.alliance-matrix h4{font-size:.65rem;color:var(--bigdata-purple);text-transform:uppercase;letter-spacing:1px;margin-bottom:.6rem;font-weight:800}
.alliance-item{display:flex;align-items:center;gap:8px;padding:.4rem 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.6rem}
