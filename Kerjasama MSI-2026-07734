.unit-info{flex:1;min-width:0}
.unit-name{font-size:.7rem;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.unit-meta{font-size:.5rem;color:var(--text-dim);font-family:'Courier New',monospace;margin-top:2px}
.unit-status{font-size:.5rem;font-weight:700;padding:2px 8px;border-radius:20px;text-transform:uppercase}
.unit-status.ready{background:rgba(46,255,176,.15);color:var(--green)}
.unit-status.deployed{background:rgba(255,215,0,.15);color:var(--gold);animation:pulseLive 1.5s infinite}
