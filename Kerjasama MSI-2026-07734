function calcTotal() {
  const b = portfolioState.btc.amount * portfolioState.btc.price;
  const e = portfolioState.eth.amount * portfolioState.eth.price;
  const g = portfolioState.gold.amount * portfolioState.gold.price;
  const c = portfolioState.cash.amount;
  return b + e + g + c;
}

function fmtRM(n) {
  if (n >= 1e9) return 'RM ' + (n/1e9).toFixed(2) + 'B';
  if (n >= 1e6) return 'RM ' + (n/1e6).toFixed(2) + 'M';
  return 'RM ' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
}

