    row.innerHTML = `<span class="ml-time">${time}</span><span class="ml-op ${m.op}">${m.op.toUpperCase()}</span><span class="ml-msg">${m.msg}</span><span class="ml-status">${m.status.toUpperCase()}</span>`;
    log.prepend(row);
    while (log.children.length > 12) log.removeChild(log.lastChild);
  }, 4500);

  setInterval(() => {
    const el = document.getElementById('milopsPersonnel'); if (el) el.textContent = (12800+Math.floor(Math.random()*100)).toLocaleString();
    const cy = document.getElementById('milopsCyber'); if (cy) cy.textContent = (1200+Math.floor(Math.random()*100)).toLocaleString();
    const re = document.getElementById('milopsRecon'); if (re) re.textContent = 40+Math.floor(Math.random()*8);
  }, 3800);
}

/* ============================================================
   THREE.JS CORE
   ============================================================ */
function init3DCore() {
  const container = document.getElementById('three3DContainer');
  if (!container || typeof THREE === 'undefined') return;

  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x000308, 0.035);
  const camera = new THREE.PerspectiveCamera(55, container.clientWidth/container.clientHeight, 0.1, 2000);
  camera.position.set(0, 30, 90);
  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  container.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0x00e5ff, 0.35));
  const pl1 = new THREE.PointLight(0x00e5ff, 2, 400); pl1.position.set(50,60,50); scene.add(pl1);
  const pl2 = new THREE.PointLight(0xffd700, 1.6, 400); pl2.position.set(-60,-40,40); scene.add(pl2);

  const starGeo = new THREE.BufferGeometry();
  const arr = new Float32Array(1200*3);
  for (let i=0;i<arr.length;i++) arr[i] = (Math.random()-0.5)*800;
  starGeo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
  scene.add(new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0x88ccff, size: 0.6, transparent: true, opacity: 0.65 })));

  const coreNode = new THREE.Mesh(
    new THREE.IcosahedronGeometry(4,1),
    new THREE.MeshStandardMaterial({ color: 0x00ffd0, emissive: 0x00ffd0, emissiveIntensity: 0.85, metalness: 0.9, roughness: 0.15, flatShading: true })
  );
  scene.add(coreNode);
  const halo = new THREE.Mesh(
    new THREE.SphereGeometry(5.4,24,24),
    new THREE.MeshBasicMaterial({ color: 0x00ffd0, transparent: true, opacity: 0.12, wireframe: true })
  );
  scene.add(halo);

  const countryNodes = [];
  const sphereR = 34;
  const edgeColors = [0x00e5ff,0x2effb0,0xa78bfa,0xfb7185,0xffd700,0x00ffd0];
  for (let i=0;i<205;i++) {
    const phi = Math.acos(1-2*(i+0.5)/205);
    const theta = Math.PI*(1+Math.sqrt(5))*i;
    const x = sphereR*Math.cos(theta)*Math.sin(phi);
    const y = sphereR*Math.cos(phi);
    const z = sphereR*Math.sin(theta)*Math.sin(phi);
    const col = edgeColors[i%edgeColors.length];
    const node = new THREE.Mesh(new THREE.SphereGeometry(0.55,10,10), new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.85 }));
    node.position.set(x,y,z);
    node.userData = { phase: Math.random()*Math.PI*2 };
    scene.add(node); countryNodes.push(node);
    scene.add(new THREE.Line(
      new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0), new THREE.Vector3(x,y,z)]),
      new THREE.LineBasicMaterial({ color: col, transparent: true, opacity: 0.12 })
    ));
  }

  const edgeNodes = [];
  for (let i=0;i<14;i++) {
    const a = (i/14)*Math.PI*2;
    const n = new THREE.Mesh(
      new THREE.OctahedronGeometry(1.1,0),
      new THREE.MeshStandardMaterial({ color: 0x00ffd0, emissive: 0x00ffd0, emissiveIntensity: 0.9 })
    );
    n.position.set(Math.cos(a)*22, Math.sin(a*0.6)*6, Math.sin(a)*22);
    n.userData = { orbitA: a };
    scene.add(n); edgeNodes.push(n);
  }

  const ring = new THREE.Mesh(
    new THREE.TorusGeometry(sphereR+5, 0.08, 8, 128),
    new THREE.MeshBasicMaterial({ color: 0xffd700, transparent: true, opacity: 0.35 })
  );
  ring.rotation.x = Math.PI/2; scene.add(ring);

  const packets = [];
  function spawnPacket() {
    const col = edgeColors[Math.floor(Math.random()*edgeColors.length)];
    const p = new THREE.Mesh(new THREE.SphereGeometry(0.28,8,8), new THREE.MeshBasicMaterial({ color: col }));
    const phi = Math.acos(2*Math.random()-1);
    const theta = Math.random()*Math.PI*2;
    const end = new THREE.Vector3(sphereR*Math.cos(theta)*Math.sin(phi), sphereR*Math.cos(phi), sphereR*Math.sin(theta)*Math.sin(phi));
    p.userData = { t: 0, speed: 0.008+Math.random()*0.012, end, start: new THREE.Vector3(0,0,0) };
    scene.add(p); packets.push(p);
  }
  setInterval(spawnPacket, 350);

  let dragging = false, px = 0, py = 0, az = 0, el = 0.35, dist = 100;
  container.addEventListener('mousedown', e => { dragging = true; px = e.clientX; py = e.clientY; });
  window.addEventListener('mouseup', () => dragging = false);
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    az -= (e.clientX-px)*0.005;
    el = Math.max(-1.4, Math.min(1.4, el + (e.clientY-py)*0.005));
    px = e.clientX; py = e.clientY;
  });
  container.addEventListener('wheel', e => { e.preventDefault(); dist = Math.max(50, Math.min(180, dist + e.deltaY*0.08)); }, { passive: false });

  window.set3DMode = (mode, btn) => {
    document.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    if (mode === 'orbit') dist = 100;
    if (mode === 'explode') {
      countryNodes.forEach(n => n.position.addScaledVector(n.position.clone().normalize(), 12));
      setTimeout(() => countryNodes.forEach(n => n.position.copy(n.position.clone().normalize().multiplyScalar(sphereR))), 1200);
    }
  };
  window.reset3DCamera = () => { az = 0; el = 0.35; dist = 100; };
  window.spawn3DPacket = () => { for (let i=0;i<8;i++) setTimeout(spawnPacket, i*40); };

  let fc = 0, lastFps = performance.now();
  const clock = new THREE.Clock();
  (function loop() {
    requestAnimationFrame(loop);
    const t = clock.getElapsedTime();
    if (!dragging) az += 0.0015;
    camera.position.set(dist*Math.cos(el)*Math.sin(az), dist*Math.sin(el), dist*Math.cos(el)*Math.cos(az));
    camera.lookAt(0,0,0);
    coreNode.rotation.x = t*0.3; coreNode.rotation.y = t*0.5;
    const pulse = 1 + Math.sin(t*2)*0.06;
    coreNode.scale.set(pulse,pulse,pulse);
    halo.rotation.y = t*0.15;
    countryNodes.forEach(n => n.scale.setScalar(1 + Math.sin(t*2+n.userData.phase)*0.18));
    edgeNodes.forEach(n => { n.userData.orbitA += 0.004; n.position.x = Math.cos(n.userData.orbitA)*22; n.position.z = Math.sin(n.userData.orbitA)*22; });
    ring.rotation.z = t*0.15;
    for (let i=packets.length-1;i>=0;i--) {
      const p = packets[i]; p.userData.t += p.userData.speed;
      const tt = p.userData.t;
      if (tt >= 1) { scene.remove(p); packets.splice(i,1); continue; }
      p.position.lerpVectors(p.userData.start, p.userData.end, 1-Math.pow(1-tt,2));
    }
    renderer.render(scene, camera);
    fc++;
    const now = performance.now();
    if (now-lastFps >= 1000) {
      const f = document.getElementById('hudFps'); if (f) f.textContent = fc;
      const oe = document.getElementById('hudObjs'); if (oe) oe.textContent = scene.children.length;
      const hl = document.getElementById('hudLat'); if (hl) hl.textContent = (8+Math.floor(Math.random()*25))+'ms';
      fc = 0; lastFps = now;
    }
  })();
  window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth/container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
  });
}

/* ============================================================
   MULTI-SCENE 3D
   ============================================================ */
function initMultiScene() {
  if (typeof THREE === 'undefined') return;
  const scenes = {}, renderers = {}, cameras = {}, clocks = {};
  let active = 'chain';

  function buildChain(c) {
    const s = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(55, c.clientWidth/c.clientHeight, 0.1, 1000);
    cam.position.set(0,8,34); cam.lookAt(0,0,0);
    const r = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    r.setSize(c.clientWidth, c.clientHeight);
    r.setPixelRatio(Math.min(window.devicePixelRatio, 2)); r.setClearColor(0x000000,0);
    c.appendChild(r.domElement);
    s.add(new THREE.AmbientLight(0xffd700, 0.4));
    const p1 = new THREE.PointLight(0xffd700, 2.2, 200); p1.position.set(20,20,20); s.add(p1);
    const p2 = new THREE.PointLight(0x00ffd0, 1.6, 200); p2.position.set(-20,-10,15); s.add(p2);
    const blocks = [];
    for (let i=0;i<8;i++) {
      const color = new THREE.Color().setHSL(0.45 + (i/8)*0.05, 0.85, 0.55);
      const block = new THREE.Mesh(new THREE.BoxGeometry(3.2,3.2,1.6),
        new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 0.35, metalness: 0.85, roughness: 0.25, transparent: true, opacity: 0.88 }));
      block.position.set((i-4)*5.5, 0, 0);
      block.userData = { phase: i*0.5 };
      s.add(block); blocks.push(block);
    }
    for (let i=0;i<blocks.length-1;i++) {
      s.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([blocks[i].position, blocks[i+1].position]),
        new THREE.LineBasicMaterial({ color: 0x00ffd0, transparent: true, opacity: 0.6 })
      ));
    }
    let drag=false, px=0, py=0, az=0, el=0.1, dist=34;
    c.addEventListener('mousedown', e => { drag=true; px=e.clientX; py=e.clientY; });
    window.addEventListener('mouseup', () => drag=false);
    window.addEventListener('mousemove', e => { if(!drag) return; az-=(e.clientX-px)*0.004; el=Math.max(-0.9,Math.min(0.9,el+(e.clientY-py)*0.004)); px=e.clientX; py=e.clientY; });
    c.addEventListener('wheel', e => { e.preventDefault(); dist=Math.max(15,Math.min(70,dist+e.deltaY*0.05)); }, { passive: false });
    return { scene: s, camera: cam, renderer: r, update(t) {
      if (!drag) az += 0.0025;
      cam.position.set(dist*Math.cos(el)*Math.sin(az), dist*Math.sin(el)+3, dist*Math.cos(el)*Math.cos(az));
      cam.lookAt(0,0,0);
      blocks.forEach((b,i) => { b.rotation.y = t*0.3 + b.userData.phase; b.position.y = Math.sin(t+i*0.6)*0.35; });
    }};
  }

  function buildHelix(c) {
    const s = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(55, c.clientWidth/c.clientHeight, 0.1, 1000);
    cam.position.set(0,0,30); cam.lookAt(0,0,0);
    const r = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    r.setSize(c.clientWidth, c.clientHeight); r.setPixelRatio(Math.min(window.devicePixelRatio,2)); r.setClearColor(0x000000,0);
    c.appendChild(r.domElement);
    s.add(new THREE.AmbientLight(0xa78bfa, 0.5));
    const p1 = new THREE.PointLight(0xa78bfa, 2, 200); p1.position.set(15,15,15); s.add(p1);
    const p2 = new THREE.PointLight(0x00ffd0, 1.8, 200); p2.position.set(-15,-10,10); s.add(p2);
    const helix = new THREE.Group();
    for (let i=0;i<42;i++) {
      const y = (i-21)*0.9, a = i*0.32;
      const posA = new THREE.Vector3(Math.cos(a)*4.5, y, Math.sin(a)*4.5);
      const posB = new THREE.Vector3(Math.cos(a+Math.PI)*4.5, y, Math.sin(a+Math.PI)*4.5);
      const mat = new THREE.MeshStandardMaterial({ color: i%2===0?0x00e5ff:0x00ffd0, emissive: i%2===0?0x00e5ff:0x00ffd0, emissiveIntensity: 0.7 });
      const sA = new THREE.Mesh(new THREE.SphereGeometry(0.5,12,12), mat); sA.position.copy(posA); helix.add(sA);
      const sB = new THREE.Mesh(new THREE.SphereGeometry(0.5,12,12), mat.clone()); sB.position.copy(posB); helix.add(sB);
      helix.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([posA,posB]),
        new THREE.LineBasicMaterial({ color: [0xffd700,0x2effb0,0xfb7185,0xa78bfa][i%4], transparent: true, opacity: 0.7 })));
    }
    s.add(helix);
    let drag=false, px=0, py=0, az=0, el=0, dist=30;
    c.addEventListener('mousedown', e => { drag=true; px=e.clientX; py=e.clientY; });
    window.addEventListener('mouseup', () => drag=false);
    window.addEventListener('mousemove', e => { if(!drag) return; az-=(e.clientX-px)*0.004; el=Math.max(-1,Math.min(1,el+(e.clientY-py)*0.004)); px=e.clientX; py=e.clientY; });
    c.addEventListener('wheel', e => { e.preventDefault(); dist=Math.max(12,Math.min(65,dist+e.deltaY*0.05)); }, { passive: false });
    return { scene: s, camera: cam, renderer: r, update(t) {
      if (!drag) az += 0.003;
      cam.position.set(dist*Math.cos(el)*Math.sin(az), dist*Math.sin(el), dist*Math.cos(el)*Math.cos(az));
      cam.lookAt(0,0,0);
      helix.rotation.y = t*0.35;
    }};
  }

  function buildRadar(c) {
    const s = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(50, c.clientWidth/c.clientHeight, 0.1, 1000);
    cam.position.set(0,24,22); cam.lookAt(0,0,0);
    const r = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    r.setSize(c.clientWidth, c.clientHeight); r.setPixelRatio(Math.min(window.devicePixelRatio,2)); r.setClearColor(0x000000,0);
    c.appendChild(r.domElement);
    s.add(new THREE.AmbientLight(0xa78bfa, 0.6));
    const grid = new THREE.GridHelper(40,20,0xa78bfa,0x2c2c4a);
    grid.material.transparent = true; grid.material.opacity = 0.25; s.add(grid);
    for (let i=1;i<=4;i++) {
      const ring = new THREE.Mesh(new THREE.RingGeometry(i*4-0.05, i*4+0.05, 64),
        new THREE.MeshBasicMaterial({ color: 0xa78bfa, transparent: true, opacity: 0.4, side: THREE.DoubleSide }));
      ring.rotation.x = -Math.PI/2; ring.position.y = 0.06; s.add(ring);
    }
    const sweep = new THREE.Mesh(new THREE.PlaneGeometry(18,0.3),
      new THREE.MeshBasicMaterial({ color: 0x00ffd0, transparent: true, opacity: 0.75, side: THREE.DoubleSide }));
    sweep.rotation.x = -Math.PI/2; sweep.position.set(9,0.1,0);
    const sweepGroup = new THREE.Group(); sweepGroup.add(sweep); s.add(sweepGroup);
    const blips = [];
    const colors = [0xffd700,0x00e5ff,0xa78bfa,0x00ffd0,0xfb7185];
    for (let i=0;i<24;i++) {
      const a = Math.random()*Math.PI*2, rad = 3+Math.random()*14;
      const col = colors[i%colors.length];
      const blip = new THREE.Mesh(new THREE.SphereGeometry(0.55,12,12),
        new THREE.MeshStandardMaterial({ color: col, emissive: col, emissiveIntensity: 1 }));
      blip.position.set(Math.cos(a)*rad, 0.5, Math.sin(a)*rad);
      blip.userData = { phase: Math.random()*Math.PI*2, baseY: 0.5 };
      s.add(blip); blips.push(blip);
    }
    let drag=false, px=0, py=0, az=0, el=0.35, dist=34;
    c.addEventListener('mousedown', e => { drag=true; px=e.clientX; py=e.clientY; });
    window.addEventListener('mouseup', () => drag=false);
    window.addEventListener('mousemove', e => { if(!drag) return; az-=(e.clientX-px)*0.005; el=Math.max(0.1,Math.min(1.3,el+(e.clientY-py)*0.005)); px=e.clientX; py=e.clientY; });
    c.addEventListener('wheel', e => { e.preventDefault(); dist=Math.max(18,Math.min(70,dist+e.deltaY*0.06)); }, { passive: false });
    return { scene: s, camera: cam, renderer: r, update(t) {
      if (!drag) az += 0.0018;
      cam.position.set(dist*Math.cos(el)*Math.sin(az), dist*Math.sin(el), dist*Math.cos(el)*Math.cos(az));
      cam.lookAt(0,0,0);
      sweepGroup.rotation.y = -t*1.4;
      blips.forEach(b => { b.scale.setScalar(1+Math.sin(t*3+b.userData.phase)*0.3); b.position.y = b.userData.baseY + Math.sin(t*2+b.userData.phase)*0.3; });
    }};
  }

  function buildThreat(c) {
    const s = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(55, c.clientWidth/c.clientHeight, 0.1, 1000);
    cam.position.set(0,0,32); cam.lookAt(0,0,0);
    const r = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    r.setSize(c.clientWidth, c.clientHeight); r.setPixelRatio(Math.min(window.devicePixelRatio,2)); r.setClearColor(0x000000,0);
    c.appendChild(r.domElement);
    s.add(new THREE.AmbientLight(0xfb7185, 0.4));
    const p1 = new THREE.PointLight(0xfb7185, 2.2, 200); p1.position.set(15,15,20); s.add(p1);
    const p2 = new THREE.PointLight(0x00ffd0, 1.5, 200); p2.position.set(-15,-10,10); s.add(p2);
    const core = new THREE.Mesh(new THREE.OctahedronGeometry(4,0),
      new THREE.MeshStandardMaterial({ color: 0xffd700, emissive: 0xffb300, emissiveIntensity: 0.9, metalness: 0.9, roughness: 0.2, flatShading: true }));
    s.add(core);
    const shield = new THREE.Mesh(new THREE.SphereGeometry(6,24,16),
      new THREE.MeshBasicMaterial({ color: 0x00ffd0, transparent: true, opacity: 0.12, wireframe: true }));
    s.add(shield);
    const threats = [];
    const threatColors = [0xfb7185,0xff4444,0xff9100];
    function spawn() {
      const a = Math.random()*Math.PI*2, ph = (Math.random()-0.5)*Math.PI*0.8, startR = 28;
      const sx = Math.cos(a)*Math.cos(ph)*startR, sy = Math.sin(ph)*startR, sz = Math.sin(a)*Math.cos(ph)*startR;
      const col = threatColors[Math.floor(Math.random()*threatColors.length)];
      const th = new THREE.Mesh(new THREE.SphereGeometry(0.5,8,8), new THREE.MeshBasicMaterial({ color: col }));
      th.position.set(sx,sy,sz);
      th.userData = { t: 0, speed: 0.012+Math.random()*0.008, start: new THREE.Vector3(sx,sy,sz) };
      s.add(th); threats.push(th);
    }
    setInterval(spawn, 600);
    let drag=false, px=0, py=0, az=0, el=0.15, dist=30;
    c.addEventListener('mousedown', e => { drag=true; px=e.clientX; py=e.clientY; });
    window.addEventListener('mouseup', () => drag=false);
    window.addEventListener('mousemove', e => { if(!drag) return; az-=(e.clientX-px)*0.005; el=Math.max(-1,Math.min(1,el+(e.clientY-py)*0.005)); px=e.clientX; py=e.clientY; });
    c.addEventListener('wheel', e => { e.preventDefault(); dist=Math.max(15,Math.min(60,dist+e.deltaY*0.06)); }, { passive: false });
    return { scene: s, camera: cam, renderer: r, update(t) {
      if (!drag) az += 0.0028;
      cam.position.set(dist*Math.cos(el)*Math.sin(az), dist*Math.sin(el), dist*Math.cos(el)*Math.cos(az));
      cam.lookAt(0,0,0);
      core.rotation.x = t*0.5; core.rotation.y = t*0.7;
      shield.rotation.y = -t*0.2;
      for (let i=threats.length-1;i>=0;i--) {
        const th = threats[i]; th.userData.t += th.userData.speed;
        const tt = th.userData.t;
        if (tt >= 1) { s.remove(th); threats.splice(i,1); continue; }
        th.position.lerpVectors(th.userData.start, new THREE.Vector3(0,0,0), tt*0.92);
      }
    }};
  }

  const containers = {
    chain: document.getElementById('scene-chain'),
    helix: document.getElementById('scene-helix'),
    radar: document.getElementById('scene-radar'),
    threat: document.getElementById('scene-threat')
  };
  const builders = { chain: buildChain, helix: buildHelix, radar: buildRadar, threat: buildThreat };

  function activate(name) {
    if (!containers[name]) return;
    if (!scenes[name]) {
      const b = builders[name](containers[name]);
      scenes[name] = b.scene; cameras[name] = b.camera; renderers[name] = b.renderer; clocks[name] = new THREE.Clock();
      scenes[name].userData = { update: b.update };
    }
    active = name;
    Object.entries(containers).forEach(([k,c]) => { if (!c) return; c.classList.toggle('hidden', k !== name); });
    const r = renderers[name], cam = cameras[name], c = containers[name];
    if (r && c) { cam.aspect = c.clientWidth/c.clientHeight; cam.updateProjectionMatrix(); r.setSize(c.clientWidth, c.clientHeight); }
    const si = document.getElementById('siScene'); if (si) si.textContent = name.toUpperCase();
  }
  window.switchScene = (name, btn) => {
    document.querySelectorAll('.scene-tab').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    activate(name);
  };
  activate('chain');
  let fc = 0, lastFps = performance.now();
  (function loop() {
    requestAnimationFrame(loop);
    const name = active;
    const r = renderers[name], s = scenes[name], cam = cameras[name], c = containers[name];
    if (!r || !s || !cam || !c || c.classList.contains('hidden')) return;
    const clk = clocks[name];
    const t = clk ? clk.getElapsedTime() : 0;
    if (s.userData?.update) s.userData.update(t);
    r.render(s, cam);
    fc++;
    const now = performance.now();
    if (now-lastFps >= 1000) { const f = document.getElementById('siFps'); if (f) f.textContent = fc; fc = 0; lastFps = now; }
  })();
}

