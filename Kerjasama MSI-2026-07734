.mil-value.violet{border-left-color:var(--violet);color:var(--violet)}
.mil-value.btc{border-left-color:var(--btc-orange);color:var(--btc-orange)}
.mil-value.eth{border-left-color:var(--eth-blue);color:var(--eth-blue)}
.mil-value.finance{border-left-color:var(--finance-green);color:var(--finance-green)}
.mil-value.quantum{border-left-color:var(--quantum-pink);color:var(--quantum-pink)}
.mil-value.threat{border-left-color:var(--threat-red);color:var(--threat-red)}
.mil-value.bio{border-left-color:var(--bio-mint);color:var(--bio-mint)}

/* ===== LICENSE CARDS ===== */
.license-card{background:#000;border:1px solid rgba(0,255,255,.35);border-left:4px solid var(--cyan);border-radius:18px;padding:8px 12px;box-shadow:0 0 10px rgba(0,255,255,.08);margin-bottom:6px;transition:.3s}
.license-card:hover{border-left-color:var(--gold)}
.license-card.gold{border-left-color:var(--gold);border:1px solid rgba(255,215,0,.3)}
.license-card.patent{border-left-color:#60a5fa}
.license-card.trademark{border-left-color:#fbbf24}
.license-card.design{border-left-color:#fb7185}
.license-card.copyright{border-left-color:#a78bfa}
.license-card.gi{border-left-color:#2effb0}
.license-card.aws{border-left-color:#ff9900}
.license-card.bio{border-left-color:var(--bio-mint);border:1px solid rgba(0,255,208,.35);background:linear-gradient(160deg,#000,#001a16)}
.license-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:4px}
.license-title{font-size:.68rem;font-weight:800;letter-spacing:.8px;color:#dffcff;text-transform:uppercase}
.license-status{font-size:.55rem;padding:2px 8px;border-radius:20px;border:1px solid currentColor;font-weight:700;color:var(--green)}
.license-status.active{color:var(--green)}
.license-status.verified{color:var(--gold)}
.license-status.pending{color:var(--gold)}
.license-status.live{color:var(--cyan);animation:pulseLive 2s infinite}
.license-meta{font-size:.6rem;color:#c7d9ef;line-height:1.6}
.entity-tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.entity-tag{font-size:.5rem;padding:2px 10px;border-radius:20px;background:#0a121f;border:1px solid #2c5f8a;color:#94a3b8}
.stamp{font-size:.5rem;background:#000;padding:6px 10px;border-radius:30px;margin-top:12px;text-align:center;color:var(--cyan);font-weight:700;border:1px solid rgba(0,255,255,.2)}
#qrcode{background:#fff;padding:6px;border-radius:16px;width:85px;margin:10px auto 0;box-shadow:0 4px 18px rgba(0,0,0,.6)}

/* ===== FINGERPRINT ===== */
.fingerprint-block{background:linear-gradient(160deg,#000,#001a16);border:1px solid rgba(0,255,208,.4);border-radius:24px;padding:1rem;margin:1rem 0;position:relative;overflow:hidden;box-shadow:0 0 30px rgba(0,255,208,.15)}
.fingerprint-block::before{content:'';position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--bio-mint),transparent);box-shadow:0 0 16px var(--bio-mint);animation:bioScan 3s linear infinite;pointer-events:none;z-index:3}
.fingerprint-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.7rem;position:relative;z-index:2}
.fingerprint-title{font-size:.68rem;font-weight:800;color:var(--bio-mint);letter-spacing:1.5px;text-transform:uppercase}
.fingerprint-badge{font-size:.5rem;padding:3px 10px;border-radius:20px;background:rgba(0,255,208,.12);border:1px solid var(--bio-mint);color:var(--bio-mint);font-weight:800;letter-spacing:.5px;animation:pulseLive 2s infinite}
.fingerprint-body{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;position:relative;z-index:2}
.fingerprint-svg-wrap{flex-shrink:0;width:130px;height:160px;background:radial-gradient(ellipse at center,rgba(0,255,208,.08),transparent 70%);border-radius:16px;display:flex;align-items:center;justify-content:center;position:relative}
.fingerprint-svg-wrap svg{width:110px;height:140px;filter:drop-shadow(0 0 6px rgba(0,255,208,.5))}
.fingerprint-svg-wrap .fp-dot{animation:bioPulse 2s infinite}
.fingerprint-data{flex:1;min-width:180px}
.fingerprint-data .fp-row{display:flex;justify-content:space-between;align-items:center;font-size:.6rem;padding:.28rem 0;border-bottom:1px dashed rgba(0,255,208,.12);font-family:'Share Tech Mono','Courier New',monospace}
.fingerprint-data .fp-row .fp-k{color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px;font-size:.5rem}
.fingerprint-data .fp-row .fp-v{color:var(--bio-mint);font-weight:700}
.fingerprint-data .fp-row .fp-v.gold{color:var(--gold)}
.fingerprint-data .fp-row .fp-v.cyan{color:var(--cyan)}
.fingerprint-hash{font-family:'Share Tech Mono','Courier New',monospace;font-size:.55rem;color:var(--bio-mint);background:#000;padding:6px 10px;border-radius:12px;border-left:3px solid var(--bio-mint);margin-top:.5rem;word-break:break-all;letter-spacing:.5px}
.fingerprint-verify{display:flex;justify-content:space-between;align-items:center;margin-top:.6rem;font-size:.55rem;color:var(--text-dim)}
.fingerprint-verify .ok{color:var(--green);font-weight:800;display:flex;align-items:center;gap:6px}

/* ===== OWNER MASTER SEAL ===== */
.owner-master-seal{display:flex;align-items:center;gap:1.2rem;background:linear-gradient(160deg,#0a0800,#000);border:2px solid var(--gold);border-radius:24px;padding:1rem 1.2rem;margin:1rem 0;box-shadow:0 0 40px rgba(255,215,0,.2);flex-wrap:wrap;position:relative;overflow:hidden}
.owner-master-seal::before{content:'';position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent,rgba(255,215,0,.08),transparent,rgba(255,215,0,.08),transparent);animation:rotateGlow 12s linear infinite;pointer-events:none}
.owner-master-seal > *{position:relative;z-index:2}
.owner-master-seal svg{filter:drop-shadow(0 0 12px rgba(255,215,0,.6))}
.owner-master-seal > div{flex:1;min-width:200px}
.owner-master-seal h4{font-size:.9rem;font-weight:900;color:var(--gold);letter-spacing:1.5px;margin-bottom:.3rem}
.owner-master-seal p{font-size:.55rem;color:var(--bio-mint);font-family:'Share Tech Mono',monospace;word-break:break-all;line-height:1.5}

/* ===== RIGHT PORTFOLIO ===== */
.portfolio-right{background:#02070e;border-radius:2rem;border:1px solid rgba(72,187,255,.3);padding:1.5rem;box-shadow:0 10px 40px rgba(0,0,0,.7)}
.portfolio-right h1{font-size:1.8rem;background:linear-gradient(135deg,#fff,#7bc3ff);-webkit-background-clip:text;background-clip:text;color:transparent}
.portfolio-right h2{font-size:1.15rem;margin:1.5rem 0 .8rem;border-left:4px solid #3b82f6;padding-left:1rem;color:#cde3ff}

/* ===== PANELS ===== */
.live-update-panel,.live-3d-panel,.milops-panel,.geoint-panel,.fxmatrix-panel,.sigint-panel,.timezone-panel,.finance-panel,.coop-panel,.sovereign-complete-panel,.biometric-panel{border-radius:32px;padding:1.5rem;margin:2rem 0;position:relative;overflow:hidden}
.live-update-panel{background:linear-gradient(160deg,#000,#02070e);border:1px solid rgba(0,229,255,.35);box-shadow:0 0 30px rgba(0,229,255,.15)}
.live-3d-panel{background:radial-gradient(ellipse at center,#06101e 0%,#000 80%);border:1px solid rgba(255,215,0,.35);box-shadow:0 0 40px rgba(255,215,0,.12)}
.milops-panel{background:linear-gradient(160deg,#0a0000,#1a0505);border:2px solid rgba(255,68,68,.5);box-shadow:0 0 50px rgba(255,68,68,.15)}
.geoint-panel{background:linear-gradient(160deg,#000,#0a0612);border:1px solid rgba(179,136,255,.4);box-shadow:0 0 40px rgba(179,136,255,.12)}
.fxmatrix-panel{background:linear-gradient(160deg,#000,#0a0800);border:1px solid rgba(255,215,0,.4);box-shadow:0 0 40px rgba(255,215,0,.1)}
.sigint-panel{background:linear-gradient(160deg,#000,#050015);border:1px solid rgba(0,229,255,.4);box-shadow:0 0 40px rgba(0,229,255,.12)}
.timezone-panel{background:linear-gradient(160deg,#000,#02070e);border:1px solid rgba(0,229,255,.3);box-shadow:0 0 40px rgba(0,229,255,.1)}
.finance-panel{background:linear-gradient(160deg,#000,#02090e);border:2px solid rgba(0,214,143,.4);box-shadow:0 0 40px rgba(0,214,143,.12)}
.coop-panel{background:linear-gradient(160deg,#0a000a,#1a0512);border:2px solid rgba(255,143,171,.4);box-shadow:0 0 40px rgba(255,143,171,.12)}
.sovereign-complete-panel{background:linear-gradient(160deg,#000,#02070e);border:2px solid rgba(255,215,0,.4);box-shadow:0 0 40px rgba(255,215,0,.12)}
.biometric-panel{background:linear-gradient(160deg,#000,#001a16);border:2px solid rgba(0,255,208,.5);box-shadow:0 0 50px rgba(0,255,208,.18)}
.panel-header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1rem;padding-bottom:.8rem;position:relative;z-index:2}
.panel-header h2{font-size:1.3rem;margin:0;-webkit-background-clip:text;background-clip:text;color:transparent}
.live-update-panel h2{background:linear-gradient(135deg,var(--cyan),var(--gold))}
.live-3d-panel h2{background:linear-gradient(135deg,var(--gold),var(--cyan))}
.milops-panel h2{background:linear-gradient(135deg,#ff4444,#ff8800);letter-spacing:1px}
.geoint-panel h2{background:linear-gradient(135deg,var(--bigdata-purple),var(--cyan))}
.fxmatrix-panel h2{background:linear-gradient(135deg,var(--gold),var(--btc-orange))}
.sigint-panel h2{background:linear-gradient(135deg,var(--cyan),var(--green))}
.timezone-panel h2{background:linear-gradient(135deg,var(--cyan),var(--gold))}
.finance-panel h2{background:linear-gradient(135deg,var(--finance-green),var(--cyan))}
.coop-panel h2{background:linear-gradient(135deg,#ff8fab,var(--gold))}
.sovereign-complete-panel h2{background:linear-gradient(135deg,var(--gold),var(--cyan))}
.biometric-panel h2{background:linear-gradient(135deg,var(--bio-mint),var(--cyan))}
.live-pulse{display:inline-block;width:10px;height:10px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);animation:pulseLive 1.5s infinite;margin-right:8px}

.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-bottom:1.2rem;position:relative;z-index:2}
.metric-card{background:#0a121f;border:1px solid #2c5f8a;border-radius:16px;padding:.9rem 1rem;text-align:center;transition:.3s}
.metric-card:hover{border-color:var(--cyan);transform:translateY(-3px);box-shadow:0 0 20px rgba(0,229,255,.2)}
.metric-card .mc-label{font-size:.5rem;text-transform:uppercase;color:var(--text-dim);letter-spacing:1px;margin-bottom:.3rem}
.metric-card .mc-value{font-size:1.5rem;font-weight:800;font-family:'Courier New',monospace;color:var(--cyan)}
.metric-card .mc-value.gold{color:var(--gold)}
.metric-card .mc-value.green{color:var(--green)}
.metric-card .mc-value.bio{color:var(--bio-mint)}
.metric-card .mc-value.violet{color:var(--violet)}
.metric-card .mc-sub{font-size:.5rem;color:var(--text-dim);margin-top:2px}

.feed-panel{background:#000;border-radius:12px;padding:.8rem;max-height:220px;overflow-y:auto;font-family:'Courier New',monospace;font-size:.6rem;color:var(--text-dim);border:1px solid #1e293b;margin-bottom:1rem;position:relative;z-index:2}
.feed-entry{padding:.35rem 0;border-bottom:1px solid rgba(255,255,255,.04);display:flex;gap:10px;animation:slideIn .4s ease-out}
.feed-entry .fe-time{color:var(--cyan);flex-shrink:0}
.feed-entry .fe-tag{font-weight:700;font-size:.55rem;padding:0 6px;border-radius:6px;flex-shrink:0}
.fe-tag.new{background:rgba(46,255,176,.15);color:var(--green)}
.fe-tag.fix{background:rgba(255,215,0,.15);color:var(--gold)}
.fe-tag.sec{background:rgba(251,113,133,.15);color:var(--rose)}
.fe-tag.ai{background:rgba(179,136,255,.15);color:var(--bigdata-purple)}
.fe-tag.os{background:rgba(0,229,255,.15);color:var(--cyan)}
.fe-tag.mil{background:rgba(255,68,68,.15);color:#ff4444}
.fe-tag.bio{background:rgba(0,255,208,.15);color:var(--bio-mint)}
.feed-entry .fe-msg{color:var(--text);flex:1}

#three3DContainer{width:100%;height:480px;border-radius:20px;background:radial-gradient(ellipse at center,#0a1528 0%,#000 90%);border:1px solid rgba(0,229,255,.15);position:relative;overflow:hidden;cursor:grab}
#three3DContainer:active{cursor:grabbing}
#three3DContainer canvas{display:block}

.scene-tabs{display:flex;gap:.4rem;margin-bottom:.8rem;flex-wrap:wrap;position:relative;z-index:2}
.scene-tab{padding:.4rem 1rem;border-radius:30px;font-size:.6rem;font-weight:700;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:.2s;background:rgba(0,229,255,.06);border:1px solid rgba(0,229,255,.25);color:var(--cyan)}
.scene-tab:hover{background:rgba(0,229,255,.15)}
.scene-tab.active{background:var(--cyan);color:#000;box-shadow:0 0 20px rgba(0,229,255,.4)}
.scene-tab.gold.active{background:var(--gold);border-color:var(--gold)}
.scene-tab.violet.active{background:var(--violet);border-color:var(--violet)}
.scene-tab.rose.active{background:var(--rose);border-color:var(--rose)}
.scene-3d-container{width:100%;height:420px;border-radius:20px;background:radial-gradient(ellipse at center,#0a1528 0%,#000 90%);border:1px solid rgba(0,229,255,.15);position:relative;overflow:hidden;cursor:grab}
.scene-3d-container canvas{display:block}
.scene-3d-container.hidden{display:none}

.info-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.5rem;margin-top:.8rem;position:relative;z-index:2}
.info-item{background:rgba(0,0,0,.5);border:1px solid rgba(0,229,255,.12);border-radius:10px;padding:.5rem .7rem;text-align:center}
.info-item .ii-label{font-size:.5rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.5px}
.info-item .ii-val{font-family:'Courier New',monospace;font-size:.95rem;font-weight:800;color:var(--cyan);margin-top:2px}
.info-item .ii-val.gold{color:var(--gold)}
.info-item .ii-val.green{color:var(--green)}

.btn-row{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem;position:relative;z-index:2}
.btn{background:rgba(0,229,255,.08);border:1px solid rgba(0,229,255,.3);color:var(--cyan);padding:.4rem 1rem;border-radius:30px;font-size:.6rem;font-weight:700;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:.2s}
.btn:hover{background:var(--cyan);color:#000;box-shadow:0 0 20px rgba(0,229,255,.4)}
.btn.gold{color:var(--gold);border-color:rgba(255,215,0,.35);background:rgba(255,215,0,.08)}
.btn.gold:hover{background:var(--gold);color:#000}
.btn.green{color:var(--green);border-color:rgba(46,255,176,.35);background:rgba(46,255,176,.08)}
.btn.green:hover{background:var(--green);color:#000}
.btn.bio{color:var(--bio-mint);border-color:rgba(0,255,208,.4);background:rgba(0,255,208,.08)}
.btn.bio:hover{background:var(--bio-mint);color:#000}

/* ===== MILOPS ===== */
.milops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.8rem;margin-bottom:1rem;position:relative;z-index:2}
.milops-card{background:rgba(0,0,0,.6);border:1px solid rgba(255,68,68,.25);border-radius:14px;padding:.8rem;position:relative;overflow:hidden}
.milops-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#ff4444}
.milops-card.green::before{background:var(--green)}
.milops-card.cyan::before{background:var(--cyan)}
.milops-card.gold::before{background:var(--gold)}
.milops-card.violet::before{background:var(--violet)}
.milops-card.bio::before{background:var(--bio-mint)}
.milops-card .mc-label{font-size:.5rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;font-weight:700}
.milops-card .mc-value{font-size:1.4rem;font-weight:900;font-family:'Courier New',monospace;color:#ff4444;margin-top:3px;line-height:1.1}
.milops-card.green .mc-value{color:var(--green)}
.milops-card.cyan .mc-value{color:var(--cyan)}
.milops-card.gold .mc-value{color:var(--gold)}
.milops-card.violet .mc-value{color:var(--violet)}
.milops-card.bio .mc-value{color:var(--bio-mint)}
.milops-card .mc-sub{font-size:.5rem;color:var(--text-dim);margin-top:3px}
.defcon-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 16px;border-radius:30px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;font-size:.7rem}
.defcon-3{background:rgba(255,215,0,.15);color:var(--gold);border:2px solid var(--gold);animation:pulseLive 2s infinite}
.defcon-5{background:rgba(46,255,176,.15);color:var(--green);border:2px solid var(--green)}
.milops-units{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.6rem;position:relative;z-index:2}
.unit-card{background:rgba(0,0,0,.5);border:1px solid rgba(255,68,68,.2);border-radius:12px;padding:.7rem;display:flex;align-items:center;gap:10px}
