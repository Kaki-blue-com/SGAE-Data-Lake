    { city: 'Singapore', flag: '🇸🇬', offset: 8, market: { open: 9, close: 17 } },
    { city: 'Hong Kong', flag: '🇭🇰', offset: 8, market: { open: 9.5, close: 16 } },
    { city: 'Shanghai', flag: '🇨🇳', offset: 8, market: { open: 9.5, close: 15 } },
    { city: 'Tokyo', flag: '🇯🇵', offset: 9, market: { open: 9, close: 15 } },
    { city: 'Sydney', flag: '🇦🇺', offset: 11, market: { open: 10, close: 16 } },
    { city: 'Kuala Lumpur', flag: '🇲🇾', offset: 8, market: { open: 9, close: 17 } },
    { city: 'São Paulo', flag: '🇧🇷', offset: -3, market: { open: 10, close: 17 } }
  ];
  const grid = document.getElementById('tzGrid');
  const utcTimeEl = document.getElementById('utcTime');
  const utcDateEl = document.getElementById('utcDate');
  function update() {
    const now = new Date();
    const utcH = now.getUTCHours(), utcM = now.getUTCMinutes(), utcS = now.getUTCSeconds();
    if (utcTimeEl) utcTimeEl.textContent = `${pad(utcH)}:${pad(utcM)}:${pad(utcS)}`;
    if (utcDateEl) {
      const days = ['Ahad','Isnin','Selasa','Rabu','Khamis','Jumaat','Sabtu'];
      const months = ['Jan','Feb','Mac','Apr','Mei','Jun','Jul','Ogos','Sep','Okt','Nov','Dis'];
      utcDateEl.textContent = `${days[now.getUTCDay()]}, ${now.getUTCDate()} ${months[now.getUTCMonth()]} ${now.getUTCFullYear()}`;
    }
    if (!grid) return;
    grid.innerHTML = zones.map(z => {
      const totalMin = (utcH + Math.floor(z.offset))*60 + utcM + ((z.offset%1)*60);
      const finalH = Math.floor((totalMin+1440)%1440/60);
      const finalM = Math.floor((totalMin+1440)%60);
      const localTime = finalH + finalM/60;
      const isOpen = localTime >= z.market.open && localTime < z.market.close;
      const offsetStr = z.offset >= 0 ? `UTC+${z.offset}` : `UTC${z.offset}`;
      return `<div class="tz-item"><span class="tz-flag">${z.flag}</span>
        <div class="tz-info"><div class="tz-city">${z.city}</div><div class="tz-offset">${offsetStr}</div></div>
        <div class="tz-time ${isOpen?'market-open':'market-closed'}">${pad(finalH)}:${pad(finalM)}</div></div>`;
    }).join('');
  }
  update(); setInterval(update, 1000);
}

