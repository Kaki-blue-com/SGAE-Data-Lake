          <div class="ci-change" style="color:${c.change>=0?'var(--green)':'var(--rose)'}">${c.change>=0?'▲':'▼'} ${Math.abs(c.change).toFixed(2)}%</div></div>
      </div>`).join('');
  }
  renderCom();
  setInterval(() => { commodities.forEach(c => { c.price *= (1+(Math.random()-0.5)*0.003); c.change += (Math.random()-0.5)*0.25; }); renderCom(); }, 6500);
}

/* ============================================================
   SIGINT
   ============================================================ */
function initSigInt() {
  const canvas = document.getElementById('spectrumCanvas');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const DPR = window.devicePixelRatio || 1;
    function resize() { canvas.width = canvas.clientWidth*DPR; canvas.height = canvas.clientHeight*DPR; ctx.setTransform(DPR,0,0,DPR,0,0); }
    resize(); window.addEventListener('resize', resize);
    const peaks = [
      { f: 0.08, h: 0.6, c: '#00e5ff' }, { f: 0.18, h: 0.4, c: '#2effb0' },
      { f: 0.32, h: 0.8, c: '#a78bfa' }, { f: 0.47, h: 0.5, c: '#FFD700' },
      { f: 0.58, h: 0.9, c: '#ff6ec7' }, { f: 0.72, h: 0.45, c: '#00e5ff' },
      { f: 0.85, h: 0.65, c: '#2effb0' }, { f: 0.93, h: 0.3, c: '#a78bfa' }
    ];
    let tick = 0;
    (function draw() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      ctx.clearRect(0,0,w,h);
      ctx.strokeStyle = 'rgba(0,229,255,0.06)'; ctx.lineWidth = 1;
      for (let i=1;i<8;i++) { const x = (w/8)*i; ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }
      for (let i=1;i<4;i++) { const y = (h/4)*i; ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }
      peaks.forEach((p,i) => {
        const jitter = Math.sin(tick*0.1+i)*0.03;
        const x = (p.f+jitter)*w, peakH = (p.h+Math.sin(tick*0.05+i)*0.1)*h;
        const grad = ctx.createLinearGradient(x-30,0,x+30,0);
        grad.addColorStop(0,p.c+'00'); grad.addColorStop(0.5,p.c+'AA'); grad.addColorStop(1,p.c+'00');
        ctx.fillStyle = grad; ctx.beginPath(); ctx.moveTo(x-40,h);
        for (let px=-40;px<=40;px++) { const y = h-peakH*Math.exp(-(px*px)/200); ctx.lineTo(x+px,y); }
        ctx.lineTo(x+40,h); ctx.closePath(); ctx.fill();
        ctx.strokeStyle = p.c; ctx.lineWidth = 2; ctx.shadowColor = p.c; ctx.shadowBlur = 8;
        ctx.beginPath(); ctx.moveTo(x,h); ctx.lineTo(x,h-peakH); ctx.stroke(); ctx.shadowBlur = 0;
        ctx.fillStyle = p.c; ctx.font = '8px "Courier New"'; ctx.textAlign = 'center';
        ctx.fillText((p.f*20).toFixed(1)+'GHz', x, h-peakH-4);
      });
      tick++;
      requestAnimationFrame(draw);
    })();
  }
  const freqs = [
    { freq: '30.5 MHz', type: 'hf', signal: 'strong' }, { freq: '118.2 MHz', type: 'vhf', signal: 'strong' },
    { freq: '243.0 MHz', type: 'vhf', signal: 'med' }, { freq: '432.1 MHz', type: 'uhf', signal: 'strong' },
    { freq: '1.575 GHz', type: 'sat', signal: 'strong' }, { freq: '2.4 GHz', type: 'shf', signal: 'strong' },
    { freq: '5.8 GHz', type: 'shf', signal: 'med' }, { freq: '10.7 GHz', type: 'shf', signal: 'weak' },
    { freq: '14.2 GHz', type: 'sat', signal: 'med' }, { freq: '22.5 GHz', type: 'sat', signal: 'strong' }
  ];
  const fl = document.getElementById('freqList');
  if (fl) fl.innerHTML = freqs.map(f => `
    <div class="freq-item"><span class="fi-freq">${f.freq}</span>
      <span class="fi-type ${f.type}">${f.type.toUpperCase()}</span>
      <span class="fi-signal" style="color:${f.signal==='weak'?'var(--rose)':f.signal==='med'?'var(--gold)':'var(--green)'}">${f.signal.toUpperCase()}</span></div>`).join('');
}

