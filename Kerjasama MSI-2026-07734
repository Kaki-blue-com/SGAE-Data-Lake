.mission-log{background:#000;border-radius:12px;border:1px solid rgba(255,68,68,.25);padding:.8rem;max-height:200px;overflow-y:auto;font-family:'Courier New',monospace;font-size:.6rem;position:relative;z-index:2;margin-top:.8rem}
