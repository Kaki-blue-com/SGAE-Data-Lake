.mission-log-row .ml-op{font-weight:800;font-size:.5rem;padding:1px 6px;border-radius:5px;text-align:center;text-transform:uppercase}
.ml-op.recon{background:rgba(0,229,255,.15);color:var(--cyan)}
.ml-op.cyber{background:rgba(167,139,250,.15);color:var(--violet)}
.ml-op.intel{background:rgba(255,215,0,.15);color:var(--gold)}
.ml-op.strike{background:rgba(255,68,68,.2);color:#ff4444}
.ml-op.defend{background:rgba(46,255,176,.15);color:var(--green)}
.ml-op.bio{background:rgba(0,255,208,.15);color:var(--bio-mint)}
.mission-log-row .ml-msg{color:var(--text)}
.mission-log-row .ml-status{font-size:.5rem;font-weight:700;color:var(--green)}

